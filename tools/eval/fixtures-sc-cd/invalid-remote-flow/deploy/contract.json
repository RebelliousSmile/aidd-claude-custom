{
  "version": 2,
  "owner": { "plugin": "sc-python", "scope": "root" },
  "manager": "uv",
  "command": "uv run scripts/deploy.py",
  "workingDirectory": ".",
  "source": { "repository": "git", "ref": "ef56cd3", "clean": true },
  "targets": [
    { "id": "railway-main", "phase": "production", "mode": "automata", "provider": "railway", "executionContext": "automation-checkout", "lifecycleRevision": 1, "guard": { "kind": "provider-metadata", "reference": "SC_CD_LIFECYCLE" }, "lock": { "key": "deploy-railway-main", "behavior": "wait" }, "invocation": { "command": "uv run scripts/deploy.py --target railway-main", "workingDirectory": ".", "operations": ["pull:data"] } }
  ],
  "operations": [
    { "name": "pull:data", "surface": "data", "authority": "target", "phases": ["production"], "preconditions": ["source target selected"], "proof": ["destination matches"], "recovery": ["restore destination"] }
  ]
}
