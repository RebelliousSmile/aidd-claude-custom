{
  "version": 2,
  "owner": { "plugin": "sc-python", "scope": "root" },
  "manager": "uv",
  "command": "uv run scripts/deploy.py",
  "workingDirectory": ".",
  "source": { "repository": "git", "ref": "abc1234", "clean": true },
  "secrets": { "token": "must-never-appear-in-output" },
  "targets": [
    {
      "id": "api-main",
      "phase": "production",
      "mode": "server",
      "provider": "ssh",
      "executionContext": "workspace",
      "lifecycleRevision": 1,
      "guard": { "kind": "file", "reference": ".sc-cd/api-main.json" },
      "lock": { "key": "deploy-api-main", "behavior": "fail" },
      "invocation": { "command": "uv run scripts/deploy.py --target api-main", "workingDirectory": ".", "operations": ["deploy:code"] }
    }
  ],
  "operations": [
    { "name": "deploy:code", "surface": "code", "authority": "local", "phases": ["production"], "preconditions": ["tests pass"], "proof": ["health check passes"], "recovery": ["restore previous release"] }
  ]
}
