{
  "version": 2,
  "owner": { "plugin": "sc-js", "scope": "root" },
  "manager": "pnpm",
  "command": "pnpm deploy:prod",
  "workingDirectory": ".",
  "source": { "repository": "git", "ref": "de45bc2", "clean": true },
  "targets": [
    { "id": "site-main", "phase": "production", "mode": "server", "provider": "ssh", "executionContext": "workspace", "lifecycleRevision": 1, "guard": { "kind": "file", "reference": ".sc-cd/site-main.json" }, "lock": { "key": "deploy-site-main", "behavior": "fail" }, "invocation": { "command": "pnpm deploy:prod --target site-main", "workingDirectory": ".", "operations": ["deploy:code"] } },
    { "id": "site-main", "phase": "production", "mode": "server", "provider": "ssh", "executionContext": "workspace", "lifecycleRevision": 1, "guard": { "kind": "file", "reference": ".sc-cd/site-main-duplicate.json" }, "lock": { "key": "deploy-site-main-duplicate", "behavior": "fail" }, "invocation": { "command": "pnpm deploy:prod --target site-main", "workingDirectory": ".", "operations": ["deploy:code"] } }
  ],
  "operations": [
    { "name": "deploy:code", "surface": "code", "authority": "local", "phases": ["production"], "preconditions": ["tests pass"], "proof": ["health check passes"], "recovery": ["restore previous release"] }
  ]
}
