{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.design/wireframe-review.schema.json",
  "title": "Design wireframe review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "reviewer", "reviewedAt", "artifact", "staticReport", "renderedReport"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "enum": ["accepted", "revoked"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "artifact": { "$ref": "#/$defs/digest" },
    "staticReport": { "$ref": "#/$defs/digest" },
    "renderedReport": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
