{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://my-marketplace.local/sc-cd/project-contract.schema.json",
  "title": "SC-CD project delivery contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "owner", "manager", "command", "workingDirectory", "source", "target", "operations"],
  "properties": {
    "version": { "const": 1 },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin", "scope"],
      "properties": {
        "plugin": { "type": "string", "pattern": "^sc-[a-z0-9-]+$" },
        "scope": { "const": "root" }
      }
    },
    "manager": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "workingDirectory": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider"],
      "properties": {
        "kind": { "enum": ["server", "automata"] },
        "provider": { "type": "string", "minLength": 1 }
      }
    },
    "trigger": { "enum": ["manual", "push"], "default": "manual" },
    "secretNames": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    },
    "contributors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plugin", "scope"],
        "properties": {
          "plugin": { "type": "string", "pattern": "^sc-[a-z0-9-]+$" },
          "scope": { "type": "string", "minLength": 1, "not": { "const": "root" } }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "direction", "preconditions", "proof", "recovery"],
        "properties": {
          "name": { "type": "string", "pattern": "^(deploy|pull):[a-z0-9:-]+$" },
          "direction": { "enum": ["local-to-production", "production-to-local"] },
          "preconditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "proof": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "recovery": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "automata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "workingDirectory", "operations"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "workingDirectory": { "type": "string", "minLength": 1 },
        "operations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
